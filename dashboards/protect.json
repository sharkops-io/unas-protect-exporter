    {
      "id": 2,
      "type": "stat",
      "title": "Leak",
      "description": "Reflects a leak in the last 10 minutes, matching the ProtectSensorLeakDetected alert's window. The or-vector(0) fallback renders that as None rather than leaving the panel blank.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "None",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - max by (sensor) (protect_sensor_leak_detected_timestamp_seconds) < 600) or on() vector(0)",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ]
    },
